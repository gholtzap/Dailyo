{
  "fonts": [
    "-apple-system",
    "BlinkMacSystemFont",
    "SF Pro Text",
    "SF Pro Display",
    "Segoe UI",
    "sans-serif"
  ],
  "fontSizes": [12, 13, 14, 16, 18, 24],
  "typeRules": [
    { "selector": "h1", "sizes": [24] },
    { "selector": "h2", "sizes": [16, 18, 24] },
    { "selector": "h3", "sizes": [14] },
    { "selector": "button, [role=button]", "sizes": [12, 13, 14] }
  ],
  "minControlSize": 24,
  "minControlGap": 8,
  "minControlInset": 8,
  "minLayoutGap": 8,
  "viewports": [
    { "width": 390, "height": 844 },
    { "width": 1440, "height": 1000 }
  ],
  "colorSchemes": ["dark"],
  "exceptions": []
}
