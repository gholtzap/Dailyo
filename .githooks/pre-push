#!/usr/bin/env bash
set -euo pipefail
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" == "$zero" ]]; then continue; fi
  if [[ "$remote_sha" == "$zero" ]]; then
    base=$(git merge-base "$local_sha" refs/remotes/origin/main)
  else
    base=$remote_sha
  fi
  # Validate the actual pushed tip, including branches that are not checked out.
  if [[ "$(git rev-parse HEAD)" != "$local_sha" ]]; then
    echo 'Check out the pushed branch before running the pre-push checks.' >&2
    exit 1
  fi
  bun scripts/ci-feedback.ts "$base" --local
done
