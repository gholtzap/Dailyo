{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "installCommand": "bun install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/rush/",
      "destination": "/index.html"
    },
    {
      "source": "/rush/:game/",
      "destination": "/index.html"
    },
    {
      "source": "/rush/:game*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "functions": {
    "api/score-maintenance.ts": {
      "regions": ["iad1"]
    },
    "api/daily-score.ts": {
      "includeFiles": "dist/{data/{network,challenges}.json,games/data/{flags,languages,vocabulary,maprot,yearrot,borderrot,ladderrot,ladder-words,cluerot,scalerot,skyrot,pricerot,skylinerot,zoomrot,orderrot}.json,world-data/cities.json,world-data/*/{network,challenges}.json}",
      "regions": ["iad1"]
    }
  },
  "crons": [
    {
      "path": "/api/score-maintenance",
      "schedule": "0 10 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "redirects": [
    {
      "source": "/rush/cluerot/:path*",
      "destination": "/cluerot/",
      "permanent": true
    },
    {
      "source": "/rush/ladderrot/:path*",
      "destination": "/ladderrot/",
      "permanent": true
    },
    {
      "source": "/anglerot/:path*",
      "destination": "/daily/",
      "permanent": true
    },
    {
      "source": "/rush/anglerot/:path*",
      "destination": "/rush/",
      "permanent": true
    },
    {
      "source": "/splitrot/:path*",
      "destination": "/daily/",
      "permanent": true
    },
    {
      "source": "/rush/splitrot/:path*",
      "destination": "/rush/",
      "permanent": true
    },
    {
      "source": "/scalerot/:path*",
      "destination": "/daily/",
      "permanent": true
    },
    {
      "source": "/rush/scalerot/:path*",
      "destination": "/rush/",
      "permanent": true
    },
    {
      "source": "/temporot/:path*",
      "destination": "/daily/",
      "permanent": true
    },
    {
      "source": "/rush/temporot/:path*",
      "destination": "/rush/",
      "permanent": true
    },
    {
      "source": "/countrot/:path*",
      "destination": "/daily/",
      "permanent": true
    },
    {
      "source": "/rush/countrot/:path*",
      "destination": "/rush/",
      "permanent": true
    },
    {
      "source": "/swaprot/:path*",
      "destination": "/daily/",
      "permanent": true
    },
    {
      "source": "/rush/swaprot/:path*",
      "destination": "/rush/",
      "permanent": true
    },
    {
      "source": "/trackrot/:path*",
      "destination": "/daily/",
      "permanent": true
    },
    {
      "source": "/rush/trackrot/:path*",
      "destination": "/rush/",
      "permanent": true
    }
  ]
}
