{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": {
    "api/daily-score.js": {
      "includeFiles": "dist/{data/{network,challenges}.json,games/data/*.json}",
      "regions": ["iad1"]
    }
  },
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  }
}
